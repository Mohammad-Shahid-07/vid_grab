<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <!-- Thumbnail & Title Body Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 16:9 Thumbnail -->
        <ImageView
            android:id="@+id/notif_thumbnail"
            android:layout_width="80dp"
            android:layout_height="50dp"
            android:background="@drawable/notification_thumbnail_bg"
            android:scaleType="centerCrop"
            android:contentDescription="Video Thumbnail" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Video Title"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Modern Sleek Gold Progress Bar -->
    <ProgressBar
        android:id="@+id/notif_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:indeterminateOnly="false"
        android:progressTint="#E5A93C"
        android:progressBackgroundTint="#2C2C32"
        android:max="100"
        android:progress="0" />

    <!-- Dedicated Full-Width Stats Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Left: Downloaded / Total MB + % -->
        <TextView
            android:id="@+id/notif_size"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 MB / 0 MB"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Right: Speed & ETA -->
        <TextView
            android:id="@+id/notif_speed_eta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="0 KB/s • ETA --"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#E5A93C"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
